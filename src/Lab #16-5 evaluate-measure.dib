#!csharp

// 從FHIR Server, 取得高血壓 Condition.code.code.code = "I10" 的病患清單, 使用 _has
var fhirClient = new FhirClient("http://127.0.0.1:8080/fhir");

// GET [base]/Patient?_has:Condition:subject:code=I10

var searchParams = new SearchParams()
    .Where("_has:Condition:subject:code=I10");

List<Patient> patientList = new List<Patient>();
int count = 0;

Bundle patientBundle = await fhirClient.SearchAsync<Patient>(searchParams);
foreach(var patient in patientBundle.Entry){
    if (patient.Resource is Patient p)
    {
        patientList.Add(p);
    }
}

count += patientBundle.Entry.Count;

// get all patient by link
while(patientBundle != null){
    patientBundle = await fhirClient.ContinueAsync(patientBundle);
    if(patientBundle != null){
        foreach(var patient in patientBundle.Entry){
            if (patient.Resource is Patient p)
            {
                patientList.Add(p);
            }
        }
        count += patientBundle.Entry.Count;
    } 
}

Console.WriteLine($"高血壓病患總數：{count}");

#!markdown

    public static void CopyPatientDirectory(
        string sourceRoot,
        string targetRoot,
        string patientId)
    {
        if (!Directory.Exists(sourceRoot))
            throw new DirectoryNotFoundException($"Source directory not found: {sourceRoot}");

        // 找到符合 {patientId}_XX 的資料夾
        var matchedSourceDir = Directory.GetDirectories(sourceRoot)
            .FirstOrDefault(d => Path.GetFileName(d).StartsWith($"{patientId}_"));

        if (matchedSourceDir == null)
            throw new DirectoryNotFoundException($"No folder found matching pattern: {patientId}_XX");

        // 目標資料夾名稱 = {patientId}
        string targetDir = Path.Combine(targetRoot, patientId);

        CopyDirectory(matchedSourceDir, targetDir);
    }

    private static void CopyDirectory(string sourceDir, string targetDir)
    {
        Directory.CreateDirectory(targetDir);

        foreach (var file in Directory.GetFiles(sourceDir))
        {
            string targetFile = Path.Combine(targetDir, Path.GetFileName(file));
            File.Copy(file, targetFile, overwrite: true);
        }

        foreach (var subDir in Directory.GetDirectories(sourceDir))
        {
            string newSubDir = Path.Combine(targetDir, Path.GetFileName(subDir));
            CopyDirectory(subDir, newSubDir);
        }
    }

