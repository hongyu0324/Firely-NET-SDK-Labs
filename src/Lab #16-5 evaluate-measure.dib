#!csharp

private static async Task<MeasureReport> EvaluateMeasureOperation(Parameters parameters,string measureType)
{

    MeasureReport report = new MeasureReport();
    var handler = new System.Net.Http.HttpClientHandler()
    {
        ServerCertificateCustomValidationCallback = (msg, cert, chain, errors) => true
    };

    var httpClient = new System.Net.Http.HttpClient(handler)
    {
        Timeout = TimeSpan.FromMinutes(30)
    };

    var fhirClient = new FhirClient("http://localhost:8080/fhir", httpClient);

    try
    {
        string uriPath = $"http://localhost:8080/fhir/Measure/{measureType}/$evaluate-measure";
        var result = await fhirClient.OperationAsync(
            new Uri(uriPath),
            parameters);

        report = (MeasureReport)result;

        Console.WriteLine($"Measure Report Id: {report.Id}");
        Console.WriteLine($"Status: {report.Status}");
        Console.WriteLine($"Type: {report.Type}");

        foreach (var group in report.Group)
        {
            Console.WriteLine($"=== Group: {group.Code?.Coding?[0]?.Code} ===");

            foreach (var pop in group.Population)
            {
                Console.WriteLine($"Population Code: {pop.Code?.Coding?[0]?.Code}");
                Console.WriteLine($"Count: {pop.Count}");

                if (pop.SubjectResults == null)
                {
                    Console.WriteLine("No subjectResults");
                    continue;
                }

                var listRef = pop.SubjectResults.Reference;
                var containedId = listRef.Replace("#", "");

                var containedList = report.Contained
                    .OfType<List>()
                    .FirstOrDefault(l => l.Id == containedId);

                if (containedList == null)
                {
                    Console.WriteLine($"ERROR: Contained List {containedId} not found");
                    continue;
                }

                Console.WriteLine($"Contained List Id: {containedList.Id}");

                foreach (var entry in containedList.Entry)
                {
                    var patientRef = entry.Item.Reference;

                    if (!patientRef.Contains("/"))
                        patientRef = $"Patient/{patientRef}";

                    var patient = await fhirClient.ReadAsync<Patient>(patientRef);
                    Console.WriteLine($"Patient Id: {patient.Id}");
                }
            }
        }
        foreach (var group in report.Group)
        {

            // 顯示 Stratifier
            if (group.Stratifier != null)
            {
                foreach (var strat in group.Stratifier)
                {
                    Console.WriteLine($"\n--- Stratifier: {strat.ElementId} ---");

                    if (strat.Stratum != null)
                    {
                        foreach (var stratum in strat.Stratum)
                        {
                            string stratumValue = string.Empty;
                            foreach(var compoment in stratum.Component)
                            {
                                stratumValue += compoment.Value.Text;
                                stratumValue += " & ";
                            }
                            
                            stratumValue = stratumValue.Remove(stratumValue.Length - 3);
                            Console.WriteLine($"Stratum Value: {stratumValue}");

                            // 顯示每個 stratum 的 numerator / denominator
                            foreach (var pop in stratum.Population)
                            {
                                Console.WriteLine($"  Population Code: {pop.Code?.Coding?[0]?.Code}");
                                Console.WriteLine($"  Count: {pop.Count}");

                                if (pop.SubjectResults != null)
                                {
                                    var listRef = pop.SubjectResults.Reference.Replace("#", "");
                                    var containedList = report.Contained
                                        .OfType<List>()
                                        .FirstOrDefault(l => l.Id == listRef);

                                    if (containedList != null)
                                    {
                                        Console.WriteLine($"  Patient List Id: {containedList.Id}");

                                        foreach (var entry in containedList.Entry)
                                        {
                                            var patientRef = entry.Item.Reference;

                                            if (!patientRef.Contains("/"))
                                                patientRef = $"Patient/{patientRef}";

                                            Console.WriteLine($"    Patient Ref: {patientRef}");
                                        }
                                    }
                                    else
                                    {
                                        Console.WriteLine($"  ERROR: Contained List {listRef} not found");
                                    }
                                }
                            }
                        }
                    }
                    else
                    {
                        Console.WriteLine("No stratum found");
                    }
                }
            }
        }
        return report;
    }
    catch (FhirOperationException ex)
    {
        Console.WriteLine("=== OperationOutcome ===");
        Console.WriteLine(ex.Outcome.ToJson());
        return report;
    }
}

